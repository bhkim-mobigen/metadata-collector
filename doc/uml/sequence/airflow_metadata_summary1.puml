'''' databaseSchema node
''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
== databaseSchema node ==
          m.i.a.topology_runner.py -> m.i.s.d.common_db_source.py ++ : get_database_schema_names(element)
          note left : node.producer
          m.i.s.d.common_db_source.py -> m.i.s.d.database_service.py ++ : _get_filtered_schema_names()
          loop for schema_name in self.get_raw_database_schema_names()
            m.i.s.d.database_service.py -> m.i.s.d.common_db_source.py ++ : get_raw_database_schema_names()
            m.i.s.d.common_db_source.py -> sqlalchemy.engine.reflection.py ++ : self.inspector.get_schema_names()
            sqlalchemy.engine.reflection.py -> pyhive.sqlalchemy_hive.py ++ : get_schema_names(connection, ...)
            note left : 'SHOW SCHEMAS'
            pyhive.sqlalchemy_hive.py -> sqlalchemy.engine.reflection.py -- :
            sqlalchemy.engine.reflection.py -> m.i.s.d.common_db_source.py -- : yield schema_name. <atomic, ...>
            m.i.s.d.common_db_source.py -> m.i.s.d.database_service.py -- : schema_name <atomic, ...>
            m.i.s.d.database_service.py -> m.utils.filters.py ++ : filter_by_schema()
            m.utils.filters.py -> m.i.s.d.database_service.py -- : true or false
            m.i.s.d.database_service.py -> m.i.s.d.common_db_source.py -- : 'atomic'
          end

          m.i.s.d.common_db_source.py -> m.i.a.topology_runner.py -- : 'atomic'
          loop for stage in node.stages
== databaseSchema node - tags stage ==
            loop for entity_request in stage_fn(element)
              m.i.a.topology_runner.py -> m.i.s.d.database_service.py ++ : yield_database_schema_tag_details(element)
              note left : stage.processor 미구현
              m.i.s.d.database_service.py -> m.i.a.topology_runner.py -- :
              m.i.a.topology_runner.py -> m.i.a.topology_runner.py : yield from sink_request(stage: NodeStage, entity_request)
            end

== databaseSchema node - database_schema stage ==
            loop for entity_request in stage_fn(element)
              m.i.a.topology_runner.py -> m.i.s.d.database_service.py ++ : yield_database_schema(element)
              m.i.s.d.database_service.py -> m.i.a.topology_runner.py -- : entity_request: CreateDatabaseSchemaRequest
              m.i.a.topology_runner.py -> m.i.a.topology_runner.py : yield from sink_request(stage: NodeStage, entity_request)
              note left : 'atomic' 스키마 생성
            end
          end

          m.i.a.topology_runner.py -> m.i.a.topology_runner.py ++ : process_nodes(nodes: List[TopologyNode])
          loop for node in nodes
