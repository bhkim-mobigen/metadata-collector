                  m.i.s.d.sql_column_handler.py -> m.i.s.d.sql_column_handler.py : om_column<Column(**parsed_string)> = _process_complex_col_type

== table node - table stage - columns - 복합타입 처리(parsed_string != None) 끝 ==
                  m.i.s.d.sql_column_handler.py -> m.i.s.d.sql_column_handler.py : om_column.tags = self.get_column_tag_labels(table_name=table_name, column=column)
                  m.i.s.d.sql_column_handler.py -> m.i.s.d.sql_column_handler.py : table_columns.append(om_column)
                end

                m.i.s.d.sql_column_handler.py -> m.i.s.d.common_db_source.py -- : table_columns, table_constraints, foreign_columns

                m.i.s.d.common_db_source.py -> m.i.s.d.common_db_source.py ++ : get_view_definition(type, table, schema, inspector)

