== DAG 인스턴스 생성 ==

activate airflow
airflow -> oma.w.workflow_factory.py ++:
oma.w.workflow_factory.py -> oma.w.workflow_factory.py : workflow = WorkflowFactory.create(<json path>)
note left : workflow: IngestionPipeline(<json>)
oma.w.workflow_factory.py -> oma.w.workflow_factory.py : WorkflowFactory.generate_dag()
oma.w.workflow_factory.py -> oma.w.workflow_factory.py : DAG = WorkflowFactory.get_dag()
oma.w.workflow_factory.py -> airflow : DAG
deactivate

== DAG 인스턴스 실행 ==

airflow -> airflow ++ : task run
airflow -> oma.w.i.common.py ++ : metadata_ingestion_workflow(<OpenMetadataWorkflowConfig>)
oma.w.i.common.py -> oma.w.i.common.py : config = json.loads(workflow_config.json())
note left : workflow_config: OpenMetadataWorkflowConfig

== MetadataWorkflow 인스턴스 생성 ==
oma.w.i.common.py -> oma.w.i.common.py ++ : workflow = MetadataWorkflow.create(config)
oma.w.i.common.py -> oma.w.i.common.py ++ : self.source: HiveSource = self._get_source()

oma.w.i.common.py -> oma.w.i.common.py : sink = self._get_sink()
oma.w.i.common.py -> oma.w.i.common.py : self.steps = (sink,)
note left : metadata injestion 의 steps는 rest-sink 하나.
deactivate

== MetadataWorkflow 인스턴스 실행 ==
oma.w.i.common.py -> oma.w.i.common.py ++ : workflow.execute()

oma.w.i.common.py -> oma.w.i.base.py ++ : _execute_internal()
loop for record in self.source.run()
  oma.w.i.base.py -> m.i.s.d.h.metadata.py ++ : self.source.run()
  note left : HiveSource()

  m.i.s.d.h.metadata.py -> m.i.a.topology_runner.py ++ : process_nodes(nodes: List[TopologyNode])
  loop for node in nodes -> root

== root node ==
    m.i.a.topology_runner.py -> m.i.s.d.database_service.py ++ : get_services()
    note left : node.producer
    m.i.s.d.database_service.py -> m.i.a.topology_runner.py -- : element: Source : DatabaseServiceSource
    loop for stage in node.stages

== root node - database_service stage ==
      loop for entity_request in stage_fn(element)
        m.i.a.topology_runner.py -> m.i.s.d.database_service.py ++ : yield_create_request_database_service(element)
        note left: stage.processor
        m.i.s.d.database_service.py -> m.i.a.topology_runner.py -- : entity_request: CreateDatabaseServiceRequest()

        m.i.a.topology_runner.py -> m.i.a.topology_runner.py : yield from sink_request(stage: NodeStage, entity_request)
        note left
          데이터베이스서비스 생성
          stage.context 업데이트
        end note

        m.i.a.topology_runner.py -> m.i.a.topology_runner.py : self._init_cache_dict(stage=stage, child_nodes=child_nodes)
        note left: api서버로부터 캐싱
      end
    end

    loop for stage in node.stages:
      m.i.a.topology_runner.py -> m.i.a.topology_runner.py : self.clear_context(stage=stage)
      note left: stage들 context clear
    end

    m.i.a.topology_runner.py -> m.i.a.topology_runner.py ++ : process_nodes(nodes: List[TopologyNode])
    loop for node in nodes -> database
