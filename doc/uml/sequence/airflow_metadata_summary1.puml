              sqlalchemy.engine.reflection.py -> m.i.s.d.common_db_source.py -- :
              m.i.s.d.common_db_source.py -> m.i.s.d.common_db_source.py : filter_by_table()
              note left : 테이블 필터 처리
              m.i.s.d.common_db_source.py -> m.i.s.d.common_db_source.py : yield table, type
            end

            loop table_and_type in self.query_view_names_and_types(schema_name)
              m.i.s.d.common_db_source.py -> m.i.s.d.common_db_source.py : query_view_names_and_types()
              note left : if self.source_config.includeViews:
              m.i.s.d.common_db_source.py -> sqlalchemy.engine.reflection.py ++ : self.inspector.get_view_names()
              sqlalchemy.engine.reflection.py -> pyhive.sqlalchemy_hive.py ++ : m.i.s.d.h.utils.get_view_names(connection, schema, ...)
              pyhive.sqlalchemy_hive.py -> pyhive.sqlalchemy_hive.py : m.i.s.d.h.utils.get_table_names(connection, schema, ...)
              note left
                'SHOW VIEWS IN atomic'
                hive dialect의 get_view_names()는 tableType 으로 구분하는 쿼리가 없어서
                dialect의 함수를 새로 구현 한 것으로 보임.
              end note
              pyhive.sqlalchemy_hive.py -> sqlalchemy.engine.reflection.py -- :
              sqlalchemy.engine.reflection.py -> m.i.s.d.common_db_source.py -- :
              m.i.s.d.common_db_source.py -> m.i.s.d.common_db_source.py : filter_by_table()
              note left : 테이블 필터 처리
              m.i.s.d.common_db_source.py -> m.i.s.d.common_db_source.py : yield table, type
            end

            m.i.s.d.common_db_source.py -> m.i.a.topology_runner.py -- : Tuple('atomic_csv', TableType.Regular: 'Regular')
            loop for stage in node.stages
== table node - tags stage ==
              loop for entity_request in stage_fn(element)
                m.i.a.topology_runner.py -> m.i.s.d.database_service.py ++ : entity_request = yield_table_tags(element)
                note left : stage.processor 미구현
